# URL pública de la app (CTAs "Empieza gratis" / "Entrar"). Obligatoria.
NEXT_PUBLIC_APP_URL=http://localhost:7005
# Prefijo de rutas. "/factuio-portal" en GitHub Pages, vacío con dominio propio.
NEXT_PUBLIC_BASE_PATH=
# URL canónica del sitio (sitemap, Open Graph). Opcional: por defecto https://factuio.app.
NEXT_PUBLIC_SITE_URL=
# Secciones activas (el resto se muestra como «Próximamente»): precios,historias,docs,app,login.
# Sin "app", «Entrar» y «Empieza gratis» llevan a la lista de espera. Sin "login" no se muestra «Entrar».
NEXT_PUBLIC_FEATURES_LIVE=
# Lista de espera con doble confirmación de Brevo (solo servidor, nunca NEXT_PUBLIC_).
# En Brevo: crear la lista, la plantilla de doble confirmación y el atributo de contacto PERFIL (texto).
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
